MARKER_URL="http://0.0.0.0:1234/convert"
OUTPUT_FORMAT='html'

ETL_LLM_BASE_URL="https://yourprovider.com/api/v1"
ETL_LLM_NAME=model-name
ETL_LLM_API_KEY='your-api-key'

#DATABASE_TYPE=sqlite
#SQLITE_PATH="/path/to/your/database"

DATABASE_TYPE=postgres
POSTGRESQL_DSN=postgresql://etl_user:etl_user_password@127.0.0.1:5432/etl_db

EMBEDDINGS_TYPE=api
EMBEDDINGS_API_URL="http://0.0.0.0:1235/embed"
EMBEDDINGS_BATCH_SIZE=4

RERANKING_TYPE=api
RERANKING_API_URL="http://0.0.0.0:1236/rerank"
RERANKING_BATCH_SIZE=8

VECTOR_DB=chromadb
CHROMADB_HOST="0.0.0.0"
CHROMADB_PORT=1237
CHROMADB_COLLECTION="collection_name"

S3_ENDPOINT='http://0.0.0.0:1238'
S3_ACCESS_KEY='username'
S3_SECRET_KEY='password'
S3_ETL_BUCKET="bucket-name-etl"
S3_PUBLIC_BUCKET="bucket-name-final"

FILES_DIRECTORY="/path/to/your/papers"

SERVICES__OPENALEX_EMAIL='your_email'
SERVICES__OPENALEX_API_KEY='your-api-key'