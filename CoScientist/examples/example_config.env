# =========================
# AUTH (web UI)
# =========================
# One shared password for the whole deployment. There are no user accounts.
# This line holds a salted digest of the password, never the password itself,
# so a reader of this file cannot sign in. Build the line with:
#     python3 deploy/make_password_hash.py
# The gate fails closed: with AUTH__ENABLED=true and this line missing or
# malformed, the server answers 503 to every request.
AUTH__PASSWORD_HASH=
# Signs the session cookie. Unset mints a new key on each restart, which logs
# everybody out. Changing AUTH__PASSWORD_HASH also logs everybody out.
AUTH__SECRET_KEY=
# Origins allowed to open the WebSocket, comma-separated. Empty falls back to
# same-origin, which needs the proxy to pass the Host header through. Use the
# origin the browser shows, not 127.0.0.1.
AUTH__ALLOWED_ORIGINS=
# Secure flag on the session cookie. Leave the line commented out: the server
# then reads X-Forwarded-Proto and marks the cookie Secure under HTTPS only. A
# browser never returns a Secure cookie over plain HTTP. Do not set this key to
# an empty value — an empty string is not a boolean, and the server stops at
# startup.
# AUTH__COOKIE_SECURE=true
# Set to false only for a localhost-only instance.
AUTH__ENABLED=true
# How long a session cookie stays valid, in seconds. The default is 7 days.
# AUTH__SESSION_MAX_AGE=604800
# Failed logins allowed from one address per window, and the window length in
# seconds. The throttle slows guessing. It does not stop it, so use a long
# random password.
# AUTH__MAX_LOGIN_ATTEMPTS=10
# AUTH__LOGIN_WINDOW_SECONDS=900

# =========================
# LLM
# =========================
LLM__SERVICE_KEY=
LLM__OPENAI_API_KEY=

LLM__MAIN_URL=https://openrouter.ai/api/v1
LLM__SCENARIO_URL=https://openrouter.ai/api/v1
# The provider prefix (e.g. "openrouter/") selects the routing/base-URL via
# litellm. Keep it on model ids that should go through OpenRouter, otherwise
# litellm cannot infer the provider and tool-calling may misbehave.
LLM__MAIN_MODEL=openrouter/qwen/qwen3-235b-a22b-2507
LLM__SCENARIO_MODEL=qwen/qwen3-235b-a22b-2507
# Dedicated (optionally stronger) model for the CoderAgent's multi-step tool use.
# Falls back to LLM__MAIN_MODEL when empty.
LLM__CODER_MODEL=
# Small, cheap model behind the "view summary" button on an agent in the
# execution log (a few lines on what the agent did). Falls back to the model
# named in LLM__SUMMARY_URL, then to LLM__MAIN_MODEL.
LLM__AGENT_SUMMARY_MODEL=

LLM__SERVICE_URL=https://openrouter.ai/api/v1
LLM__SERVICE_CC_URL=https://openrouter.ai/api/v1/chat/completions

LLM__VISION_URL=https://openrouter.ai/api/v1;google/gemini-2.5-flash
LLM__SUMMARY_URL=https://openrouter.ai/api/v1;google/gemini-2.0-flash-lite-001
LLM__MARKER_MODEL=google/gemini-2.0-flash-lite-001
LLM__DATASETS_URL=https://openrouter.ai/api/v1;openai/gpt-5
LLM__DEEPEVAL_URL=https://openrouter.ai/api/v1;openai/gpt-4o-2024-08-06

LLM__ALLOWED_PROVIDERS=["google-vertex", "azure"]

# OpenRouter provider routing preferences (also tunable live in Web UI Settings):
# OPENROUTER_PROVIDER_SORT: "default" (balanced latency/uptime), "price" (lowest cost hoster),
# "throughput" (maximum tokens/sec), or "latency" (fastest time to first token).
OPENROUTER_PROVIDER_SORT=default
# Optional comma-separated hosters to pin or prioritize (e.g. "Together, DeepInfra, Fireworks, Groq"):
OPENROUTER_PROVIDER_ORDER=


# =========================
