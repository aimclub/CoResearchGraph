ummary (e.g. an import\n        error); ordinary test failures are re…)
ALEMBIC_EVENT {"type": "tool_call", "stage": "coder", "name": "write_file", "args": {"content": "def run_mordred_tests(extra_args=None, timeout: int = 600) -> dict:\n    \"\"\"Run mordred's bundled nose test suite and return the result summary.\n\n    Wraps ``mordred.tests.__main__.main`` (the function behind\n    ``python -m mordred.tests``): it runs nose over the ``mordred`` and\n    ``mordred._base`` packages (with doctests enabled), which includes the\n    reference-value tests in ``mordred/tests/test_by_references.py`` that\n    compare computed descriptors against the YAML references for the molecules\n    in ``mordred/tests/references/structures.sdf``.\n\n    The suite is executed in a subprocess (``python -m mordred.tests``) so that\n    nose's own runner and ``sys.exit`` are fully isolated from the caller.\n\n    Args:\n        extra_args: Optional list of extra nose arguments appended to the\n            invocation. By default the *whole* suite is run; pass e.g.\n            ``[\"mordred.tests.test_ABCIndex\"]`` to run a single (fast) test\n            module. The full suite takes ~15-60 s and, because the bundled\n            references were generated with an older RDKit, currently reports a\n            handful of floating-point mismatches.\n        timeout: Subprocess timeout in seconds (default 600).\n\n    Returns:\n        A JSON-serializable dict::\n\n            {\n              \"exitcode\": 0,            # 0 when all tests passed\n              \"ran\": 8,                 # number of tests nose ran\n              \"errors\": 0,              # nose error count\n              \"failures\": 0,            # nose failure count\n              \"ok\": True,               # ran == 0 or no errors/failures\n              \"stdout\": \"...\",          # tail of captured stdout\n              \"stderr\": \"...\",          # tail of captured stderr\n            }\n\n        The function raises :class:`RuntimeError` only if the runner itself\n        crashed without producing a ``Ran N tests`` summary (e.g. an import\n        error); ordinary test failures are reported, not raised.\n\n    Example:\n        >>> r = run_mordred_tests(extra_args=[\"mordred.tests.test_ABCIndex\"])\n        >>> r[\"ran\"]\n        8\n        >>> r[\"ok\"]\n        True\n    \"\"\"\n    import re\n    import subprocess\n    import sys\n    from pathlib import Path\n\n    REPO = Path(__file__).resolve().parent.parent.parent / \"repos\"\n    sys.path.insert(0, str(REPO))\n\n    cmd = [sys.executable, \"-m\", \"mordred.tests\"]\n    if extra_args:\n        cmd += [str(a) for a in extra_args]\n\n    proc = subprocess.run(\n        cmd,\n        capture_output=True,\n        text=True,\n        timeout=timeout,\n    )\n\n    stdout = proc.stdout or \"\"\n    stderr = proc.stderr or \"\"\n    text = stdout + \"\\n\" + stderr\n\n    ran = 0\n    m = re.search(r\"Ran (\\d+) tests\", text)\n    if m:\n        ran = int(m.group(1))\n\n    errors = 0\n    me = re.search(r\"errors=(\\d+)\", text)\n    if me:\n        errors = int(me.group(1))\n\n    failures = 0\n    mf = re.search(r\"failures=(\\d+)\", text)\n    if mf:\n        failures = int(m.group(1))\n\n    ok = proc.returncode == 0\n\n    # A real run always prints \"Ran N tests\". If it is missing AND the process\n    # exited non-zero, the runner itself crashed (import error, etc.).\n    if ran == 0 and proc.returncode != 0:\n        raise RuntimeError(\n            \"mordred test runner crashed (exit {}):\\n{}\".format(\n                proc.returncode, stderr[-2000:]\n            )\n        )\n\n    return {\n        \"exitcode\": int(proc.returncode),\n        \"ran\": ran,\n        \"errors\": errors,\n        \"failures\": failures,\n        \"ok\": bool(ok),\n        \"stdout\": stdout[-4000:],\n        \"stderr\": stderr[-4000:],\n    }\n", "relative_path": "tools/run_mordred_tests.py"}}
