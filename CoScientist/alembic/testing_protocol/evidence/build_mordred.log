n                bar.update()\n\n    @contextmanager\n    def _progress(self, quiet, total, ipynb):\n        args = {\"dynamic_ncols\": True, \"leave\": True, \"total\": total}\n\n        if quiet:\n            Bar = DummyBar\n        elif ipynb:\n            Bar = NotebookWrapper\n", "exit_code": 0}}
