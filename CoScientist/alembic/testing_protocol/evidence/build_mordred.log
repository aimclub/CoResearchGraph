r smi in smiles_list:\n        m = Chem.MolFromSmiles(smi)\n        if m is None:\n            raise ValueError(\"failed to parse SMILES: {!r}\".format(smi))\n        mols.append(m)\n\n    calc = Calculator(descriptors, ignore_3D=ignore_3D)\n    # nproc=1 -> serial, deterministic; results identical to the default.\n    df = calc.pandas(mols, nproc=1, quiet=True)\n    columns = [str(d) for d in calc.descriptors]\n\n    def to_jsonable(v):\n        if isinstance(v, MissingValueBase):\n            return None\n        if isinstance(v, bool):\n            return v\n        try:\n            import numpy as np\n\n            if isinstance(v, np.generic):\n                return v.item()\n        except ImportError:\n            pass\n        if isinstance(v, int):\n            return int(v)\n        if isinstance(v, float):\n            return float(v)\n        return str(v)\n\n    values = [[to_jsonable(v) for v in row] for row in df.values]\n\n    result = {\n        \"smiles_list\": smiles_list,\n        \"num_molecules\": len(mols),\n        \"num_descriptors\": len(calc.descriptors),\n        \"shape\": [int(df.shape[0]), int(df.shape[1])],\n        \"columns\": columns,\n        \"values\": values,\n    }\n    if \"SLogP\" in columns:\n        result[\"SLogP\"] = [to_jsonable(v) for v in df[\"SLogP\"].tolist()]\n    return result\n", "relative_path": "tools/calc_descriptors_pandas.py"}}
