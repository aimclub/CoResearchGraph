r[\"header\"]\n        'name,ABC,ABCGG'\n    \"\"\"\n    import csv as _csv\n    import io\n    import sys\n    from pathlib import Path\n\n    REPO = Path(__file__).resolve().parent.parent.parent / \"repos\"\n    sys.path.insert(0, str(REPO))\n\n    from mordred.__main__ import main  # the verified CLI entry point\n\n    # Resolve repo-relative input file paths to absolute (PathType checks\n    # os.path.isfile at parse time); leave flags and descriptor names alone.\n    resolved = []\n    for a in args:\n        if not isinstance(a, str) or a.startswith(\"-\"):\n            resolved.append(a)\n            continue\n        candidate = REPO / a\n        resolved.append(str(candidate) if candidate.is_file() else a)\n\n    # Find the -o/--output target (default \"-\" == stdout).\n    out_target = \"-\"\n    i = 0\n    while i < len(resolved):\n        if resolved[i] in (\"-o\", \"--output\") and i + 1 < len(resolved):\n            out_target = resolved[i + 1]\n            i += 2\n            continue\n        i += 1\n\n    class _StdoutCapture:\n        \"\"\"Minimal writable stream whose ``close`` is a no-op so that the\n        CLI's ``with output:`` block does not discard the captured text.\"\"\"\n\n        def __init__(self):\n            self._buf = io.StringIO()\n\n        def write(self, s):\n            self._buf.write(s)\n            return len(s)\n\n        def flush(self):\n            self._buf.flush()\n\n        def close(self):\n            pass\n\n        def isatty(self):\n            return False\n\n        def writable(self):\n            return True\n\n        def fileno(self):\n            raise OSError(\"no fileno\")\n\n        def __enter__(self):\n            return self\n\n        def __exit__(self, *exc):\n            return False\n\n    cap = _StdoutCapture()\n    old_stdout = sys.stdout\n    sys.stdout = cap\n    exitcode = 0\n    try:\n        main(resolved)\n    except SystemExit as exc:  # argparse errors -> SystemExit(2)\n        code =