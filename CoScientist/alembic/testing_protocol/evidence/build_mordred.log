unner itself\n        crashed without producing a ``Ran N tests`` summary (e.g. an import\n        error); ordinary test failures are reported, not raised.\n\n    Example:\n        >>> r = run_mordred_tests(extra_args=[\"mordred.tests.test_ABCIndex\"])\n        >>> r[\"ran\"]\n        8\n        >>> r[\"ok\"]\n        True\n    \"\"\"\n    import re\n    import subprocess\n    import sys\n    from pathlib import Path\n\n    REPO = Path(__file__).resolve().parent.parent.parent / \"repos\"\n    sys.path.insert(0, str(REPO))\n\n    cmd = [sys.executable, \"-m\", \"mordred.tests\"]\n    if extra_args:\n        cmd += [str(a) for a in extra_args]\n\n    proc = subprocess.run(\n        cmd,\n        capture_output=True,\n        text=True,\n        timeout=timeout,\n    )\n\n    stdout = proc.stdout or \"\"\n    stderr = proc.stderr or \"\"\n    text = stdout + \"\\n\" + stderr\n\n    ran = 0\n    m = re.search(r\"Ran (\\d+) tests\", text)\n    if m:\n        ran = int(m.group(1))\n\n    errors = 0\n    me = re.search(r\"errors=(\\d+)\", text)\n    if me:\n        errors = int(me.group(1))\n\n    failures = 0\n    mf = re.search(r\"failures=(\\d+)\", text)\n    if mf:\n        failures = int(mf.group(1))\n\n    ok = proc.returncode == 0\n\n    # A real run always prints \"Ran N tests\". If it is missing AND the process\n    # exited non-zero, the runner itself crashed (import error, etc.).\n    if ran == 0 and proc.returncode != 0:\n        raise RuntimeError(\n            \"mordred test runner crashed (exit {}):\\n{}\".format(\n                proc.returncode, stderr[-2000:]\n            )\n        )\n\n    return {\n        \"exitcode\": int(proc.returncode),\n        \"ran\": ran,\n        \"errors\": errors,\n        \"failures\": failures,\n        \"ok\": bool(ok),\n        \"stdout\": stdout[-4000:],\n        \"stderr\": stderr[-4000:],\n    }\n"}}
