ALEMBIC_EVENT {"type": "tool_call", "stage": "coder", "name": "write_file", "args": {"relative_path": "tools/calc_descriptors.py", "content": "def calc_descriptors(smiles: str, ignore_3D: bool = True) -> dict:\n    \"\"\"Calculate all mordred descriptors for a single molecule given as SMILES.\n\n    Wraps ``mordred._base.calculator.Calculator``: it builds an RDKit ``Mol``\n    from ``smiles``, registers every descriptor shipped with mordred (1613 when\n    ``ignore_3D=True``, 1826 when ``ignore_3D=False``) and returns the full\n    descriptor vector produced by ``Calculator.__call__``.\n\n    Args:\n        smiles: A SMILES string, e.g. ``\"c1ccccc1\"`` (benzene).\n        ignore_3D: When ``True`` (default) only the 1613 2D descriptors are\n            computed; when ``False`` the 213 3D descriptors are added (1826\n            total). 3D descriptors are ``None`` for a molecule without 3D\n            coordinates.\n\n    Returns:\n        A JSON-serializable dict::\n\n            {\n              \"smiles\": \"c1ccccc1\",\n              \"ignore_3D\": True,\n              \"num_descriptors\": 1613,            # int\n              \"descriptor_names\": [\"ABC\", ...],   # list[str], len == num_descriptors\n              \"values\": [4.242640687119286, ...], # list, len == num_descriptors;\n                                                  # missing/error values are None\n            }\n\n    Example:\n        >>> r = calc_descriptors(\"c1ccccc1\")          # benzene\n        >>> r[\"num_descriptors\"]\n        1613\n        >>> r[\"values\"][:3]\n        [4.242640687119286, 3.9999999999999996, 0]\n    \"\"\"\n    import sys\n    from pathlib import Path\n\n    REPO = Path(__file__).resolve().parent.parent.parent / \"repos\"\n    sys.path.insert(0, str(REPO))\n\n    from rdkit import Chem  # heavy; imported lazily\n    from mordred import Calculator, descriptors\n    from mordred.error import MissingValueBase\n\n    mol = Chem.MolFromSmiles(smiles)\n    if mol is None:\n        raise ValueError(\"failed to parse SMILES: {!r}\".format(smiles))\n\n    calc = Calculator(descriptors, ignore_3D=ignore_3D)\n    names = [str(d) for d in calc.descriptors]\n    raw = list(calc(mol))\n\n    def to_jsonable(v):\n        if isinstance(v, MissingValueBase):\n            return None\n        if isinstance(v, bool):\n            return v\n        try:\n            import numpy as np\n\n            if isinstance(v, np.generic):\n                return v.item()\n        except ImportError:\n            pass\n        if isinstance(v, int):\n            return int(v)\n        if isinstance(v, float):\n            return float(v)\n        return str(v)\n\n    values = [to_jsonable(v) for v in raw]\n    return {\n        \"smiles\": smiles,\n        \"ignore_3D\": bool(ignore_3D),\n        \"num_descriptors\": len(calc.descriptors),\n        \"descriptor_names\": names,\n        \"values\": values,\n    }\n"}}
