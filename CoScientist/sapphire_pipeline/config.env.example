# Copy this file to the repository root as config.env and fill in the values.
# Use addresses reachable from the Docker container; 127.0.0.1 is the container itself.
SAPPHIRE_URL=http://fpin-projects.ru:12280
PDF_CRAWLER_URL=http://fpin-projects.ru:1228
PDF_CRAWLER_USERNAME=
PDF_CRAWLER_PASSWORD=
PDF_CRAWLER_TIMEOUT=600
# OpenAlex credentials for fallback PDF downloads and metadata lookup in the shared ETL.
SERVICES__OPENALEX_EMAIL=your-email@example.org
SERVICES__OPENALEX_API_KEY=your-openalex-api-key

ETL_LLM_BASE_URL=https://openrouter.ai/api/v1
ETL_LLM_NAME=your-model-name
ETL_LLM_API_KEY=your-openrouter-key

MARKER_URL=http://marker-host:1234/convert
MARKER_TIMEOUT=600

EMBEDDINGS_TYPE=api
EMBEDDINGS_API_URL=http://embeddings-host:1235/embed
EMBEDDINGS_BATCH_SIZE=16

VECTOR_DB=chromadb
CHROMADB_HOST=chroma-host
CHROMADB_PORT=8000
CHROMADB_COLLECTION=coscientist_papers

S3_ENDPOINT=http://s3-host:9000
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_ETL_BUCKET=your-etl-bucket
S3_PUBLIC_BUCKET=your-public-bucket

# DATABASE_TYPE, SQLITE_PATH and FILES_DIRECTORY are set by compose.yaml.
